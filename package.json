{
  "name": "sims",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI Civilization Earth — five AI-run civilizations grow from the stone age on the real Earth.",
  "scripts": {
    "new": "tsx packages/runner/src/cli.ts new",
    "run": "tsx packages/runner/src/cli.ts run",
    "status": "tsx packages/runner/src/cli.ts status",
    "history": "tsx packages/runner/src/cli.ts history",
    "web": "pnpm --filter web dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"packages/engine/test/*.test.ts\"",
    "lint": "biome lint packages"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.10.2",
    "@types/topojson-client": "^3.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "packageManager": "pnpm@11.18.0"
}
